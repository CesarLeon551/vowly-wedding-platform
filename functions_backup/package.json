{
  "name": "functions",
  "description": "Cloud Functions — firma de URLs para subir/borrar archivos en Cloudflare R2",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
